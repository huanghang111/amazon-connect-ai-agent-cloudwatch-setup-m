# Connect AI Agent 自动评估流水线 - 配置(模板)
#
#   cp config.env.example config.env
#   # 按需修改，然后:
#   ./deploy.sh
#
# 全部留空也能部署，默认值就是下面注释里写的值。
# 最省事的用法是只填 CONNECT_INSTANCE，区域 / 账号 / 日志组都从上一级的
# ../cloudfront/config-*.json 里取。

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
# ../cloudfront/config-*.json 里 connect 下的实例 key(如 connect-repair)，等同于各脚本的
# --instance。填了以后:
#   - 区域取自 ai_log_arn(没填则取自 instance_arn)，AWS_REGION 不再生效
#   - 有名为「账号 ID」的 AWS profile 时自动使用它(与上一级脚本的约定一致)
#   - CONNECT_LOG_GROUP 留空时取 ai_log_arn 里的日志组名；ai_log_arn 也没填，则按
#     setup_connect_ai_agent_logs.py 的命名规则用 /aws/connect/ai-agent-logs-<InstanceAlias>
CONNECT_INSTANCE=""

# CloudFormation 栈名
STACK_NAME_CONF="connect-agentcore-eval"

# 部署区域。留空则依次回退 CONNECT_INSTANCE 的区域 / AWS_REGION / AWS_DEFAULT_REGION /
# aws configure / us-east-1
AWS_REGION=""

# Connect AI Agent 日志组名。留空: 有 CONNECT_INSTANCE 时按上面的规则推导，
# 否则为 /aws/connect/ai-agent-logs。不确定就用 ./find-connect-log-group.sh 查。
CONNECT_LOG_GROUP=""

# 结果 S3 桶。留空则自动创建 connect-agentcore-eval-<account>-<region>
RESULTS_BUCKET=""

# AgentCore Observability 里的逻辑 runtime 名。转换后的 span/event 会写入
#   /aws/bedrock-agentcore/runtimes/<此名称>-DEFAULT
# 并以 <此名称>.DEFAULT 作为服务名被评估任务发现。
OBSERVABILITY_RUNTIME_NAME="connect-ai-agent"

# ---------------------------------------------------------------------------
# 拉取窗口
# ---------------------------------------------------------------------------
# 每次运行回看多少小时。配合每天一次的调度，24 即可覆盖全天。
LOOKBACK_HOURS="24"

# 额外往前多读的分钟数。用于兜住两类情况:
#   1) 跨窗口边界的会话(例如 23:58 接入、00:03 结束)
#   2) Connect -> CloudWatch 投递延迟，窗口关闭时最后几分钟还没落盘
# 重复不会造成重复评估: 已评估的 sessionId 记在 DynamoDB 台账里会被跳过。
OVERLAP_MINUTES="30"

# 会话「最后一个事件」需早于现在多少分钟，才认为通话已结束、可以评估。
# 防止对进行中的通话按半截对话打分(那会得到错误的分数，而不是缺失的分数)。
SETTLE_MINUTES="10"

# 已评估的 sessionId 记住多久(天)。超过后台账条目自动过期。
LEDGER_TTL_DAYS="30"

# WaitIndexed 是否也等待 aws/spans 里的 span 文档变为可查询(默认 true，两边都等)。
# 只有在确认「span 文档确实已经写进 aws/spans、但这一半的门永远打不开」时才改成
# false: 此时跳过这一半，让评估作业去报真实结果，而不是卡在等索引上超时。
REQUIRE_SPAN_INDEX="true"

# 索引门的等待预算。总等待约 INDEX_MAX_ATTEMPTS x (INDEX_BUDGET_SECONDS + 120s)。
# 某些区域第一次运行时数据变为可查询要更久(Transaction Search 刚启用后官方也说需要
# 约 10 分钟才能被搜索到),此时把这两个调大，而不是去动代码。
# INDEX_BUDGET_SECONDS 上限 240: 预算跑完后还要在同一次调用里重发事件,得留在
# Lambda 的 300s 超时之内。
INDEX_BUDGET_SECONDS="180"
INDEX_MAX_ATTEMPTS="5"

# 会话最早一条事件超过多少天，写入 Observability 前就把整个会话的时间戳平移到当前
# 时间(保留会话内部的相对时序，原始时间仍在 collect.json 里)。原因: 批量评估只能发现
# 「最近」的 span 文档——实测 13 天前的 span 会让所有评估器报 "no span documents"，
# 同一批数据平移到当前时间就正常出分。每天调度的正常运行不会触发平移。
SHIFT_OLDER_THAN_DAYS="1"

# 超过多少天的会话直接跳过(会在 collect.json 的 skipped.too_old 中列出)。
# 14 是 CloudWatch PutLogEvents 的硬限制；调大只在「回填/用归档日志验证部署」时用,
# 此时依赖 ingest 步骤把老会话的时间戳平移进窗口(SHIFT_TIMESTAMPS，默认开启)。
MAX_AGE_DAYS="14"

# 每次运行最多评估多少个会话(0 = 不限)。评估按「每条 trace x 每个评估器」计费，
# 这是控制单次运行成本上限的开关。取最新的 N 个，其余记在 collect.json 的
# skipped.deferred 里，且不写台账，下一次仍在窗口内的运行会把它们补上。
MAX_SESSIONS_PER_RUN="0"

# 仅用于验证/回放: 存放 Connect 日志 NDJSON 归档(每行 {"timestamp","message"}，
# 即上一级 cloudfront/setup_cloudfront.py 写到 s3://connect-ai-logs-<account>/raw/<实例key>/connect.ndjson
# 的格式)的 S3 桶名。填了会给 collect 步骤授予只读权限，之后可用
# run-now.sh --archive s3://<桶>/<前缀> 把历史日志回放进流水线。留空则不授权；
# 定时运行永远只读 CONNECT_LOG_GROUP。
ARCHIVE_BUCKET=""

# ---------------------------------------------------------------------------
# 评估内容
# ---------------------------------------------------------------------------
# ALL = 全部 13 个内置评估器(不含需要 ground truth 的 Trajectory*Match)。
# 也可写成逗号分隔的子集，例如:
#   EVALUATORS="Builtin.Helpfulness,Builtin.GoalSuccessRate,Builtin.ToolSelectionAccuracy"
#
# 成本提示: 评估是「每条 trace x 每个评估器」一次 LLM 调用，是本方案的主要成本项。
# API 单个任务最多 10 个评估器，因此 ALL 会并发跑 2 个任务。
EVALUATORS="ALL"

# Insights(公开预览)。留空则跳过 Insights 环节。
INSIGHTS="Builtin.Insight.FailureAnalysis,Builtin.Insight.UserIntent"

# 指导系统提示词优化的单个内置评估器(API 只允许 1 个)。
RECOMMENDATION_EVALUATOR="Helpfulness"

# ---------------------------------------------------------------------------
# 调度
# ---------------------------------------------------------------------------
# EventBridge Scheduler 表达式(UTC)。默认每天 03:00 UTC。
SCHEDULE_EXPRESSION="cron(0 3 * * ? *)"

# 是否启用定时调度。false 则只能用 run-now.sh 手动触发。
SCHEDULE_ENABLED_CONF="true"

# ---------------------------------------------------------------------------
# Transaction Search(账户级)
# ---------------------------------------------------------------------------
# AgentCore 批量评估通过 X-Ray / Transaction Search 的索引发现会话。
# 未开启时会话发现恒为 0，整条流水线会空转。deploy.sh 默认自动检查并开启。
ENABLE_TRANSACTION_SEARCH="true"

# span 索引采样率(1-100)。留空保持账户现状(默认 100)。
# 若 Connect 话务量很大、想控制 Transaction Search 成本，可下调。
INDEXING_PERCENTAGE=""

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# 本方案创建的日志组保留天数
LOG_RETENTION_DAYS="30"
